# barbarhunt — weapon loop for SwBar-base-iiii-tebw
START:
  put look
  wait
ARMCHECK:
  matchre ARMED_NOW Worn:[\s\S]*(club|sword|axe|staff|dagger|mace|blade|bow|sling|hammer)
  matchre GETCLUB carrying:[\s\S]*club
  matchre GETWEAPON carrying:
  put inventory
  matchwait 6
GETCLUB:
  put wield club
  wait
  goto ARMED
ARMED_NOW:
  setvariable armed 1
  ifge silver 112 goto GETWEAPON
  goto ARMED
GETWEAPON:
  ife room bazaar goto BUY_HERE
  move e
  move e
  move e
  move e
  move e
  move e
  ifne room bazaar goto BUY_SKIP
  goto BUY_HERE
BUY_SKIP:
  goto ARMED_FROM_BAZAAR
BUY_HERE:
ARMOR_FIRST:
  matchre KIT_WEAPONS Worn:[\s\S]*padded cloth armor
  put inventory
  matchwait 2
  iflt silver 40 KIT_WEAPONS
  put buy padded cloth armor
  wait
  put wear padded cloth armor
  wait
KIT_WEAPONS:
BUY_DAGGER:
  matchre BUY_SKIP_DAGGER Worn:[\s\S]*dagger|carrying:[\s\S]*dagger
  put inventory
  matchwait 2
  iflt silver 25 goto BUY_SKIP_DAGGER
  put buy dagger
  wait
BUY_SKIP_DAGGER:
BUY_SLING:
  matchre BUY_SKIP_SLING Worn:[\s\S]*sling|carrying:[\s\S]*sling
  put inventory
  matchwait 2
  iflt silver 20 goto BUY_SKIP_SLING
  put buy sling
  wait
BUY_SKIP_SLING:
BUY_CLUB:
  matchre BUY_SKIP_CLUB Worn:[\s\S]*club|carrying:[\s\S]*club
  put inventory
  matchwait 2
  iflt silver 112 goto BUY_SKIP_CLUB
  put buy club
  wait
BUY_SKIP_CLUB:
PLAN_DONE:
  ife armed 1 goto BUY_ARMOR
  put remove club
  put wield dagger
  wait
  goto BUY_ARMOR
BUY:
  matchre WIELD You buy|You pay|hands you
  matchre ARMED do not sell|already have|no such|do not have|out of stock|no shopkeeper
  matchre BROKE cannot afford
BUY_ARMOR:
  matchre PADDED_DONE Worn:[\s\S]*padded cloth armor
  put inventory
  matchwait 4
  put buy padded cloth armor
  wait
  put wear padded cloth armor
  wait
PADDED_DONE:
  ifge silver 120 BUY_HELM
  goto ARMED_FROM_BAZAAR
BUY_HELM:
  matchre ARMED_FROM_BAZAAR already have|Worn:[\s\S]*helm
  put buy iron helm
  wait
  put wear iron helm
  wait
  goto ARMED_FROM_BAZAAR
BROKE:
  put withdraw 100
  wait
  matchre BUY You withdraw
  matchre ARMED does not hold|no banker|nothing
  matchwait 20
  goto ARMED
WIELD:
  put wield club
  wait
  goto ARMED_HERE
ARMED:
  ifne room square goto ARMED_ANYWHERE
  move nw
  move nw
  move nw
  move n
  move n
  move n
  move n
  move d
  goto PICK_ROOM_0
ARMED_FROM_BAZAAR:
  ifne room bazaar goto ARMED_ANYWHERE
  move w
  move w
  move w
  move w
  move w
  move w
  move nw
  move nw
  move nw
  move n
  move n
  move n
  move n
  move d
  goto PICK_ROOM_0
ARMED_HERE:
  ifne room bazaar goto ARMED_ANYWHERE
  move w
  move w
  move w
  move w
  move w
  move w
  move nw
  move nw
  move nw
  move n
  move n
  move n
  move n
  move d
  goto PICK_ROOM_0
ARMED_ANYWHERE:
  goto PICK_ROOM_0
PICK_ROOM_0:
  ifne room sewers_1 goto PICK_ROOM_1
  put look
  matchwait 4
  ifgt pcount 0 goto RETURN_TO_HUB_0
PICK_ROOM_1:
  ifne room sewers_1 goto PICK_ROOM_2
  move n
  put look
  matchwait 4
  ifgt pcount 0 goto RETURN_TO_HUB_1
PICK_ROOM_2:
  ifne room sewers_1 goto PICK_ROOM_3
  move n
  move n
  put look
  matchwait 4
  ifgt pcount 0 goto RETURN_TO_HUB_2
PICK_ROOM_3:
  ifne room sewers_1 goto PICK_ROOM_4
  move n
  move n
  move d
  put look
  matchwait 4
  ifgt pcount 0 goto RETURN_TO_HUB_3
PICK_ROOM_4:
  ifne room sewers_1 goto PICK_ROOM_5
  move up
  move s
  move s
  move s
  move s
  move e
  move e
  move e
  move n
  move n
  move n
  move n
  move w
  move n
  move n
  put look
  matchwait 4
  ifgt pcount 0 goto RETURN_TO_HUB_4
PICK_ROOM_5:
  ifne room sewers_1 goto PICK_ROOM_6
  move up
  move s
  move s
  move s
  move s
  move e
  move e
  move e
  move n
  move n
  move n
  move n
  move w
  move n
  move n
  move ne
  put look
  matchwait 4
  ifgt pcount 0 goto RETURN_TO_HUB_5
PICK_ROOM_6:
  ifne room sewers_1 goto PICK_ROOM_7
  move up
  move s
  move s
  move s
  move s
  move se
  move se
  move se
  move s
  move s
  move s
  move s
  move s
  move s
  move s
  move s
  move s
  move e
  move e
  move e
  move s
  move s
  move s
  move se
  move e
  move sw
  put look
  matchwait 4
  ifgt pcount 0 goto RETURN_TO_HUB_6
PICK_ROOM_7:
  ifne room sewers_1 goto PICK_ROOM_DONE
  move up
  move s
  move s
  move s
  move s
  move se
  move se
  move se
  move s
  move s
  move s
  move s
  move s
  move s
  move s
  move s
  move s
  move e
  move e
  move e
  move s
  move s
  move s
  move se
  move e
  move e
  move n
  put look
  matchwait 4
PICK_ROOM_DONE:
  ifgt pcount 0 goto OCCUPIED_PATROL
  ifne room sewers_1 goto REANCHOR
  goto SCAN
REANCHOR:
  ifne room bazaar goto SCAN
  move w
  move w
  move w
  move w
  move w
  move w
  move nw
  move nw
  move nw
  move n
  move n
  move n
  move n
  move d
  goto PICK_ROOM_0
SCAN:
  pause 2
  iflt hp 40 goto REST
  if_2 goto SCAN_NOEXP
  setvariable 2 1
  put exp
  matchwait 5
  goto SCAN_LOOK
SCAN_NOEXP:
  setvariable 2
SCAN_LOOK:
  matchre FIGHT_rat sewer rat is here
  matchre FIGHT_silverfish silverfish is here
  matchre FIGHT_kobold kobold is here
  matchre FIGHT_great_rat great rat is here
  matchre FIGHT_marsh_hog marsh hog is here
  matchre FIGHT_reed_stalker reed stalker is here
  matchre FIGHT_mud_crab mud crab is here
  matchre FIGHT_goblin goblin is here
  matchre WANDER \[\[
  put look
  matchwait 8
FIGHT_rat:
  matchre TG_rat ^(?=\s*\[\[)(?![\s\S]*sewer rat is here)
  matchre FN_rat sewer rat is here
  put look
  matchwait 4
TG_rat:
  goto SCAN
FN_rat:
  put attack sewer rat
  wait
  put roar everilds_rage
  wait
  put analyze
  wait
  put trip sewer rat
  wait
  put skin sewer rat
  wait
  if_6 goto POSTHUNT_rat
  setvariable 6 1
  pause 5
  put forage
  wait
  goto POSTVERB_rat
POSTHUNT_rat:
  setvariable 6
  put hunt
  wait
POSTVERB_rat:
  iflt bleed 1 goto NOTEND_rat
TEND_rat:
  put tend
  wait
  put tend
  wait
NOTEND_rat:
  put look
  matchre SD_rat sewer rat is here
  matchwait 3
  pause 5
  put forage
  wait
  goto SCAN
SD_rat:
  wait
  pause 5
  put forage
  wait
  ife wsp small_edged goto ROT_S0_rat
  ife wsp slings goto ROT_S1_rat
  ife wsp blunt goto ROT_S2_rat
ROT_S0_rat:
  iflt wsr_slings 12 goto ROT_S0_TO_1_rat
  iflt wsr_blunt 12 goto ROT_S0_TO_2_rat
  goto ROT_END_rat
ROT_S0_TO_1_rat:
  put remove dagger
  put wield sling
  wait
  goto ROT_END_rat
ROT_S0_TO_2_rat:
  put remove dagger
  put wield club
  wait
  goto ROT_END_rat
ROT_S1_rat:
  iflt wsr_blunt 12 goto ROT_S1_TO_2_rat
  iflt wsr_small_edged 12 goto ROT_S1_TO_0_rat
  goto ROT_END_rat
ROT_S1_TO_2_rat:
  put remove sling
  put wield club
  wait
  goto ROT_END_rat
ROT_S1_TO_0_rat:
  put remove sling
  put wield dagger
  wait
  goto ROT_END_rat
ROT_S2_rat:
  iflt wsr_small_edged 12 goto ROT_S2_TO_0_rat
  iflt wsr_slings 12 goto ROT_S2_TO_1_rat
  goto ROT_END_rat
ROT_S2_TO_0_rat:
  put remove club
  put wield dagger
  wait
  goto ROT_END_rat
ROT_S2_TO_1_rat:
  put remove club
  put wield sling
  wait
  goto ROT_END_rat
ROT_END_rat:
  wait
  put exp
  wait
  iflt hp 40 goto REST
  goto FIGHT_rat
